+    private def wait_for_process(process : Process, completed : Channel(Process::Status), timeout_sec : Int32) : {Bool, Process::Status?}
+      select
+      when status = completed.receive
+        {false, status}
+      when timeout(timeout_sec.seconds)
+        begin
+          process.signal(Signal::TERM)
+          sleep 0.1
+          process.signal(Signal::KILL) unless process.terminated?
+          process.wait
+        rescue
+        end
+        {true, nil}
+      end
+    end

